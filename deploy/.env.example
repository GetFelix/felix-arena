# Copy to .env beside compose.yml to change a setting. Every line is optional;
# the value shown is the default.

# Which release of the arena images to run. `latest` follows new releases; use
# a version such as 0.2.0 to stay on one.
ARENA_VERSION=latest

# The address the gateway (the game) and the sign-in page listen on. The
# sign-in page signs in anyone who picks a name, so leave this on the loopback
# address unless you trust everyone who can reach the machine.
ARENA_BIND=127.0.0.1

# The address a browser reaches the sign-in page at.
ARENA_IDP_URL=http://127.0.0.1:9400

# The arenas, who may play in each, and who may only watch. Names are what
# people pick at the sign-in page.
ARENA_ARENAS=alpha bravo
ARENA_PLAYERS=ana,ben,dan,eve
ARENA_WATCHERS=cleo

# A match's lengths, in seconds, and the kills that end it early.
SIM_WARMUP_SECONDS=10
SIM_MATCH_SECONDS=300
SIM_RESULTS_SECONDS=15
SIM_KILL_LIMIT=25
